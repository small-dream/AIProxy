{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIProxy",
  "mainBinaryName": "AIProxy",
  "version": "0.1.12",
  "identifier": "com.aiproxy.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. --filter @aiproxy/desktop dev",
    "beforeBuildCommand": "pnpm --dir ../.. --filter @aiproxy/desktop build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIProxy",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc://localhost tauri://localhost https://tauri.localhost",
      "devCsp": "default-src 'self' http://localhost:1420; script-src 'self' http://localhost:1420 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://localhost:1420 ipc://localhost tauri://localhost https://tauri.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1RjczRjk1Njc4MUJCMkMKUldRc3U0Rm5sVC8zOVg2UUsxRG5QSVJ1eVlVbzRQQzFmbjZ0SXdybURxbHkxL1dPVm1pLzJKTVEK",
      "endpoints": [
        "https://github.com/small-dream/AIProxy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
