{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIProxy",
  "mainBinaryName": "AIProxy",
  "version": "0.1.0",
  "identifier": "com.aiproxy.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. --filter @aiproxy/desktop dev",
    "beforeBuildCommand": "pnpm --dir ../.. --filter @aiproxy/desktop build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIProxy",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
